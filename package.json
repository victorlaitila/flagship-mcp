{
  "name": "flagship",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @flagship/api\" \"npm run dev -w @flagship/web\"",
    "build": "npm run typecheck -w @flagship/shared && npm run build -w @flagship/api && npm run build -w @flagship/mcp && npm run build -w @flagship/web",
    "test": "npm test -w @flagship/api && npm test -w @flagship/mcp",
    "db:reset": "npm run db:reset -w @flagship/api",
    "mcp": "tsx apps/mcp/src/index.ts",
    "start": "concurrently -n api,web \"npm start -w @flagship/api\" \"npm run preview -w @flagship/web\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
